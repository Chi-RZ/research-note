# <project>/.research-note/editables.env — local paths for developed libraries.
# This file is gitignored: create it only when the project has an external
# editable. Paths may differ by machine and do not enter the public project.
# Names use letters, digits and underscores; host keys drop punctuation.
#
#   LIB_quimb_LOCAL=/home/me/src/quimb
#   LIB_quimb_hpc=/scratch/me/src/quimb
#
# Point uv at the stable project-local slot, never at either real path:
#
#   [tool.uv.sources]
#   quimb = { path = ".research-note/editables/quimb", editable = true }
#
# Run scripts/sync_editables.sh --local after editing this file. remote.sh
# setup/push creates the remote slot and aligns the two Git commits. When the
# checkout has origin, it uses push/fetch; without origin it sends a Git bundle
# over SSH. Either route requires a clean committed checkout.
